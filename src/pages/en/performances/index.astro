---
import Site from '../../../layouts/Site.astro';import {shows} from '../../../lib/pocketbase.js';const productions=await shows('en');
---
<Site lang="en" title="Performances"><main class="shell innerPage"><small>01 / ON STAGE</small><h1>PERFORMANCES.</h1><div class="shows">{productions.length?productions.map(p=><a class="show" href={`/en/performances/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ATHINAION</span>}</div><h3>{p.title}</h3></a>):<p class="empty">Upcoming performances will be announced soon.</p>}</div></main></Site>