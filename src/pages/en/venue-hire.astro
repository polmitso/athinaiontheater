import Site from '../../layouts/Site.astro';import {assets} from '../../lib/assets.js';const {centralPlan,upstagePlan}=await assets();
---
<Site lang="en" title="Venue Hire"><main class="shell innerPage"><h1>Venue hire</h1><p class="pageLead">The Main Stage and Upstage are open to companies, artists and organisations looking for a home for their work. Tell us about your idea and we will explore together how it could live on our stage.</p><div class="floorPlans"><figure><img src={centralPlan} alt="Main Stage floor plan"/><figcaption>MAIN STAGE · FLOOR PLAN</figcaption></figure><figure><img src={upstagePlan} alt="Upstage floor plan"/><figcaption>UPSTAGE · FLOOR PLAN</figcaption></figure></div><a class="lineLink" href="/en/contact">TALK TO US →</a></main></Site>