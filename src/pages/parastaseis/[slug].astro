---
import Site from '../../layouts/Site.astro';
import ShowDetail from '../../components/ShowDetail.astro';
import {shows} from '../../lib/pocketbase.js';
const lang='el';
const slug=Astro.params.slug;
const p=(await shows(lang)).find(x=>x.slug===slug);
if(!p)return Astro.redirect(lang==='en'?'/en/performances':'/parastaseis',302);
---
<Site lang={lang} title={p.title}><ShowDetail p={p} lang={lang} /></Site>
