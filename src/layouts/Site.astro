---
const {lang='el',title='Θέατρο Αθήναιον'}=Astro.props;
const en=lang==='en';
const path=Astro.url.pathname;
const pairs=[['/','/en'],['/parastaseis','/en/performances'],['/skines','/en/stages'],['/scholeia','/en/schools'],['/enoikiasi','/en/venue-hire'],['/epikoinonia','/en/contact']];
const pair=pairs.find(x=>x.includes(path.replace(/\/$/,'')||'/'))||pairs[0];
import {assets} from '../lib/assets.js';
const {logo}=await assets();
const menu=en?[['/en/performances','What’s on'],['/en/stages','Our stages'],['/en/schools','Schools'],['/en/venue-hire','Venue hire'],['/en/contact','Contact']]:[['/parastaseis','Τι παίζεται'],['/skines','Οι σκηνές'],['/scholeia','Σχολεία'],['/enoikiasi','Ενοικίαση'],['/epikoinonia','Επικοινωνία']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><link rel="icon" type="image/png" href="/favicon.png"/><link rel="apple-touch-icon" href="/favicon.png"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={en?'Athinaion Theatre in Thessaloniki — performances, stages, schools, venue hire and contact.':'Θέατρο Αθήναιον Θεσσαλονίκη — παραστάσεις, σκηνές, σχολεία, ενοικίαση και επικοινωνία.'}/><title>{title} | Αθήναιον</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Commissioner:wght@300;400;500;600&family=GFS+Didot&display=swap"/><link rel="stylesheet" href="/style.css"/><link rel="alternate" hreflang="el" href={pair[0]}/><link rel="alternate" hreflang="en" href={pair[1]}/></head><body>
<header class="top shell"><a href={en?'/en':'/'} aria-label="Athinaion"><img class="brand" src={logo} alt="Θέατρο Αθήναιον"/></a><nav aria-label="Main navigation">{menu.map(([href,label])=><a class:list={['navItem',{current:path===href}]} href={href}>{label}</a>)}</nav><div class="language"><a href={pair[0]} aria-current={!en?'page':undefined}>EL</a><span>/</span><a href={pair[1]} aria-current={en?'page':undefined}>EN</a></div></header>
<slot/>
<footer class="footer"><div class="shell footerInner"><a href={en?'/en':'/'}><img class="footerLogo" src={logo} alt="Athinaion"/></a><div class="contactInfo"><a href="https://maps.app.goo.gl/BKQLTFDM2Xx6h2L27" target="_blank" rel="noopener noreferrer">Λεωφ. Βασιλίσσης Όλγας 35, Θεσσαλονίκη 546 41 ↗</a><a href="tel:+306985603020">+30 6985 603020</a><a href="mailto:athinaiontheater@gmail.com">athinaiontheater@gmail.com</a></div><div class="socials"><a href="https://www.instagram.com/athinaiontheater/" target="_blank" rel="noopener noreferrer"><span class="socialIcon">◎</span> Instagram</a><a href="https://www.facebook.com/athinaiontheater" target="_blank" rel="noopener noreferrer"><span class="socialIcon fb">f</span> Facebook</a><a href="https://www.youtube.com/@TheatroAthinaionThessaloniki" target="_blank" rel="noopener noreferrer"><span class="socialIcon yt">▶</span> YouTube</a></div></div></footer>
</body></html>