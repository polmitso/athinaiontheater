---
import Site from '../../layouts/Site.astro';import {shows} from '../../lib/pocketbase.js';const productions=await shows();
---
<Site title="Παραστάσεις"><main class="shell innerPage"><small>01 / ON STAGE</small><h1>ΠΑΡΑΣΤΑΣΕΙΣ.</h1><div class="stageFilters" role="group" aria-label="Φίλτρο σκηνής"><button type="button" class="stageFilter active" data-stage="all" aria-pressed="true">ΟΛΕΣ</button><button type="button" class="stageFilter" data-stage="central" aria-pressed="false">ΚΕΝΤΡΙΚΗ ΣΚΗΝΗ</button><button type="button" class="stageFilter" data-stage="upstage" aria-pressed="false">UPSTAGE</button></div><div class="shows">{productions.length?productions.map(p=><a class="show" data-stages={p.stageTypes.join(" ")} href={`/parastaseis/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ΑΘΗΝΑΙΟΝ</span>}</div><h3>{p.title}</h3><div class="showStageTags">{p.stageTypes.map(stage=><span>{stage==="central"?"ΚΕΝΤΡΙΚΗ ΣΚΗΝΗ":"UPSTAGE"}</span>)}</div></a>):<p class="empty">Οι επόμενες παραστάσεις θα ανακοινωθούν σύντομα.</p>}</div></main><script is:inline>
(()=>{const buttons=[...document.querySelectorAll('.stageFilter')];const cards=[...document.querySelectorAll('.show[data-stages]')];buttons.forEach(button=>button.addEventListener('click',()=>{const value=button.dataset.stage;buttons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});cards.forEach(card=>{card.hidden=value!=='all'&&!card.dataset.stages.split(' ').includes(value)})}))})();
</script></Site>