---
import {shows} from '../lib/pocketbase.js';
const productions=await shows();
const root='https://admin.videotheatre.gr/api/files/media/';
const photo=root+'hfut6yay1aq8vpf/central_lights_iaakjev6wa.png';
const heroPhoto=root+'11rs7sgkrwmvx29/central_lights_2_wf1ily7zp5.png';
const centralPlan=root+'fq7y4ko3pgas6wr/gxvri664eg_ro8h41i7j3.png';
const upstagePlan=root+'8j6clmwj1ea0pmt/l1aq18powi_ug7taod66y.png';
const upstageLogo=root+'qcefc1nauopqetb/athinaion_upstage_white_transparent_v0yx1zby4h.png';
const upstage=root+'x36bdnm6rxknqk8/fixed_photos_2_qu786jay2o.png';
const logo=root+'29nn36f40ai14fd/athinaion_logo_web_white_transparent_cts3spf9y7.png';
---
<!doctype html><html lang="el"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Θέατρο Αθήναιον Θεσσαλονίκη — παραστάσεις, Κεντρική Σκηνή, Upstage και ενοικίαση χώρων."/><title>Θέατρο Αθήναιον | Θεσσαλονίκη</title><link rel="stylesheet" href="/style.css"/></head><body>
<header class="top shell"><a href="/" aria-label="Αθήναιον αρχική"><img class="brand" src={logo} alt="Θέατρο Αθήναιον"/></a><nav><a href="#shows">ΠΑΡΑΣΤΑΣΕΙΣ</a><a href="#stages">ΟΙ ΣΚΗΝΕΣ ΜΑΣ</a><a href="#hire">ΕΝΟΙΚΙΑΣΗ</a><a href="#contact">ΕΠΙΚΟΙΝΩΝΙΑ</a></nav></header>
<main><section class="hero"><img class="heroPhoto" src={heroPhoto} alt="Κεντρική σκηνή του Θεάτρου Αθήναιον"/><div class="shell heroText"><small>ΘΕΣΣΑΛΟΝΙΚΗ / LIVE THEATRE</small><h1>Η ΣΚΗΝΗ<br/>ΖΩΝΤΑΝΕΥΕΙ.</h1><p>Παραστάσεις, δημιουργοί και ιστορίες που συναντούν το κοινό στο Θέατρο Αθήναιον.</p><a class="lineLink" href="#shows">ΔΕΙΤΕ ΤΙΣ ΠΑΡΑΣΤΑΣΕΙΣ ↗</a></div></section>
<section id="shows" class="section shell"><div class="sectionHead"><div><small>01 / ON STAGE</small><h2>ΠΑΡΑΣΤΑΣΕΙΣ.</h2></div></div><div class="shows">{productions.length?productions.map(p=><a class="show" href={`https://preview.videotheatre.gr/productions/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title} loading="lazy"/>:<span>ΑΘΗΝΑΙΟΝ</span>}</div><h3>{p.title}</h3></a>):<p class="empty">Οι επόμενες παραστάσεις θα ανακοινωθούν σύντομα.</p>}</div></section>
<section id="stages" class="section shell"><div class="sectionHead"><div><small>02 / OUR STAGES</small><h2>ΟΙ ΣΚΗΝΕΣ ΜΑΣ.</h2></div></div><div class="stages"><article class="stage"><img src={photo} alt="Κεντρική Σκηνή"/><div><small>01 / MAIN STAGE</small><h3>ΚΕΝΤΡΙΚΗ ΣΚΗΝΗ</h3><p>Η μεγάλη θεατρική αίθουσα του Αθήναιον.</p></div></article><article class="stage"><img src={upstage} alt="Upstage"/><div><small>02 / UPSTAGE</small><img class="upstageLogo" src={upstageLogo} alt="Upstage"/><p>Ένας πιο ευέλικτος χώρος για ζωντανές παραστάσεις.</p></div></article></div></section>
<section id="hire" class="section shell hireSection"><div class="hire"><div><small>03 / VENUE HIRE</small><h2>ΕΝΟΙΚΙΑΣΗ.</h2></div><div><p>Η Κεντρική Σκηνή και το Upstage διατίθενται για θεατρικές παραστάσεις, εκδηλώσεις και συνεργασίες.</p><a class="lineLink" href="#contact">ΠΛΗΡΟΦΟΡΙΕΣ ΕΝΟΙΚΙΑΣΗΣ ↗</a></div></div><div class="floorPlans"><figure><img src={centralPlan} alt="Κάτοψη Κεντρικής Σκηνής Αθήναιον" loading="lazy"/><figcaption>ΚΕΝΤΡΙΚΗ ΣΚΗΝΗ · ΚΑΤΟΨΗ</figcaption></figure><figure><img src={upstagePlan} alt="Κάτοψη Αθήναιον Upstage" loading="lazy"/><figcaption>UPSTAGE · ΚΑΤΟΨΗ</figcaption></figure></div></section></main>
<footer id="contact" class="footer"><div class="shell footerInner"><div><img class="footerLogo" src={logo} alt="Θέατρο Αθήναιον"/></div><div class="contactInfo"><a href="https://maps.app.goo.gl/BKQLTFDM2Xx6h2L27" target="_blank" rel="noopener noreferrer">Λεωφ. Βασιλίσσης Όλγας 35, Θεσσαλονίκη 546 41 ↗</a><a href="tel:+306985603020">+30 6985 603020</a><a href="mailto:athinaiontheater@gmail.com">athinaiontheater@gmail.com</a></div><div class="socials"><a href="https://www.instagram.com/athinaiontheater/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://www.facebook.com/athinaiontheater" target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href="https://www.youtube.com/@TheatroAthinaionThessaloniki" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div></div></footer></body></html>