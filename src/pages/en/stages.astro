---
import Site from '../../layouts/Site.astro';
import {assets} from '../../lib/assets.js';const {photo,upstage,upstageLogo,centralPlan,upstagePlan}=await assets();
---
<Site lang="en" title="Our Stages"><main class="shell innerPage"><h1>Our stages</h1><div class="stageDetails">
<article class="stageDetail"><img class="stageDetailPhoto" src={photo} alt="Main Stage"/><div class="stageDetailText"><h2>Main Stage</h2><strong class="capacity">340 SEATS</strong><p>The large auditorium of Athinaion, for performances that need room to breathe.</p><button type="button" class="planButton" data-plan="central" data-src={centralPlan}>VIEW FLOOR PLAN ↗</button></div></article>
<article class="stageDetail"><img class="stageDetailPhoto" src={upstage} alt="Upstage"/><div class="stageDetailText"><img class="upstageDetailLogo" src={upstageLogo} alt="Upstage"/><strong class="capacity">145 SEATS</strong><p>A smaller, more intimate stage. This is where we experiment, take risks and listen to the audience from a breath away.</p><button type="button" class="planButton" data-plan="upstage" data-src={upstagePlan}>VIEW FLOOR PLAN ↗</button></div></article>
</div><dialog id="planDialog" class="planDialog" aria-label="Floor plan"><button class="planClose" type="button" aria-label="Close">×</button><img id="planImage" alt="Stage floor plan"/></dialog></main>
<script is:inline>
(()=>{const dialog=document.getElementById('planDialog');const image=document.getElementById('planImage');document.querySelectorAll('[data-plan]').forEach(button=>button.addEventListener('click',()=>{image.src=button.dataset.src;dialog.showModal()}));document.querySelector('.planClose')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()})})();
</script></Site>