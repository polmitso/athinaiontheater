---
const {lang='el',title='Θέατρο Αθήναιον'}=Astro.props;
const en=lang==='en';
const path=Astro.url.pathname;
const pairs=[['/','/en'],['/parastaseis','/en/performances'],['/skines','/en/stages'],['/enoikiasi','/en/venue-hire'],['/epikoinonia','/en/contact']];
const pair=pairs.find(x=>x.includes(path.replace(/\/$/,'')||'/'))||pairs[0];
const logo='https://admin.videotheatre.gr/api/files/media/29nn36f40ai14fd/athinaion_logo_web_white_transparent_cts3spf9y7.png';
const menu=en?[['/en','HOME'],['/en/performances','PERFORMANCES'],['/en/stages','OUR STAGES'],['/en/venue-hire','VENUE HIRE'],['/en/contact','CONTACT']]:[['/','ΑΡΧΙΚΗ'],['/parastaseis','ΠΑΡΑΣΤΑΣΕΙΣ'],['/skines','ΟΙ ΣΚΗΝΕΣ ΜΑΣ'],['/enoikiasi','ΕΝΟΙΚΙΑΣΗ'],['/epikoinonia','ΕΠΙΚΟΙΝΩΝΙΑ']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={en?'Athinaion Theatre in Thessaloniki — performances, stages, venue hire and contact.':'Θέατρο Αθήναιον Θεσσαλονίκη — παραστάσεις, σκηνές, ενοικίαση και επικοινωνία.'}/><title>{title} | Αθήναιον</title><link rel="stylesheet" href="/style.css"/><link rel="alternate" hreflang="el" href={pair[0]}/><link rel="alternate" hreflang="en" href={pair[1]}/></head><body>
<header class="top shell"><a href={en?'/en':'/'} aria-label="Athinaion"><img class="brand" src={logo} alt="Θέατρο Αθήναιον"/></a><nav aria-label="Main navigation">{menu.map(([href,label])=><a class:list={['navItem',{current:path===href}]} href={href}>{label}</a>)}</nav><div class="language"><a href={pair[0]} aria-current={!en?'page':undefined}>EL</a><span>/</span><a href={pair[1]} aria-current={en?'page':undefined}>EN</a></div></header>
<slot/>
<footer class="footer"><div class="shell footerInner"><a href={en?'/en':'/'}><img class="footerLogo" src={logo} alt="Athinaion"/></a><div class="contactInfo"><a href="https://maps.app.goo.gl/BKQLTFDM2Xx6h2L27" target="_blank" rel="noopener noreferrer">Λεωφ. Βασιλίσσης Όλγας 35, Θεσσαλονίκη 546 41 ↗</a><a href="tel:+306985603020">+30 6985 603020</a><a href="mailto:athinaiontheater@gmail.com">athinaiontheater@gmail.com</a></div><div class="socials"><a href="https://www.instagram.com/athinaiontheater/" target="_blank" rel="noopener noreferrer"><span class="socialIcon">◎</span> Instagram</a><a href="https://www.facebook.com/athinaiontheater" target="_blank" rel="noopener noreferrer"><span class="socialIcon fb">f</span> Facebook</a><a href="https://www.youtube.com/@TheatroAthinaionThessaloniki" target="_blank" rel="noopener noreferrer"><span class="socialIcon yt">▶</span> YouTube</a></div></div></footer>
</body></html>