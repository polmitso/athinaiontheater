---
import Site from '../layouts/Site.astro';
import {shows} from '../lib/pocketbase.js';
import {heroPhoto,photo,upstage,upstageLogo} from '../lib/assets.js';
const productions=await shows();
---
<Site><main><section class="hero"><img class="heroPhoto" src={heroPhoto} alt="Θέατρο Αθήναιον"/><div class="shell heroText"><small>ΘΕΣΣΑΛΟΝΙΚΗ / LIVE THEATRE</small><h1>Η ΣΚΗΝΗ<br/>ΖΩΝΤΑΝΕΥΕΙ.</h1><p>Παραστάσεις, δημιουργοί και ιστορίες που συναντούν το κοινό στο Θέατρο Αθήναιον.</p><a class="lineLink" href="/parastaseis">ΔΕΙΤΕ ΤΙΣ ΠΑΡΑΣΤΑΣΕΙΣ ↗</a></div></section><section class="section shell"><div class="sectionHead"><div><small>01 / ON STAGE</small><h2>ΠΑΡΑΣΤΑΣΕΙΣ.</h2></div><a class="lineLink" href="/parastaseis">ΟΛΕΣ ↗</a></div><div class="shows">{productions.length?productions.filter(p=>p.displayStatus!=='past').slice(0,3).map(p=><a class="show" href={`/parastaseis/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ΑΘΗΝΑΙΟΝ</span>}</div><h3>{p.title}</h3></a>):<p class="empty">Οι επόμενες παραστάσεις θα ανακοινωθούν σύντομα.</p>}</div></section><section class="section shell"><div class="sectionHead"><div><small>02 / OUR STAGES</small><h2>ΟΙ ΣΚΗΝΕΣ ΜΑΣ.</h2></div><a class="lineLink" href="/skines">ΠΕΡΙΣΣΟΤΕΡΑ ↗</a></div><div class="stages"><a href="/skines" class="stage"><img src={photo} alt="Κεντρική Σκηνή"/><div><small>01 / MAIN STAGE</small><h3>ΚΕΝΤΡΙΚΗ ΣΚΗΝΗ</h3></div></a><a href="/skines" class="stage"><img src={upstage} alt="Upstage"/><div><img class="upstageLogo" src={upstageLogo} alt="Upstage"/></div></a></div></section></main></Site>