---
import Site from '../../layouts/Site.astro';
import {shows} from '../../lib/pocketbase.js';
import {heroPhoto,photo,upstage,upstageLogo} from '../../lib/assets.js';
const productions=await shows('en');
---
<Site lang="en" title="Athinaion Theatre"><main><section class="hero"><img class="heroPhoto" src={heroPhoto} alt="Athinaion Theatre"/><div class="shell heroText"><small>THESSALONIKI / LIVE THEATRE</small><h1>THE STAGE<br/>COMES ALIVE.</h1><p>Performances, artists and stories meet their audience at Athinaion Theatre.</p><a class="lineLink" href="/en/performances">EXPLORE PERFORMANCES ↗</a></div></section><section class="section shell"><div class="sectionHead"><div><small>01 / ON STAGE</small><h2>PERFORMANCES.</h2></div><a class="lineLink" href="/en/performances">VIEW ALL ↗</a></div><div class="shows">{productions.length?productions.slice(0,3).map(p=><a class="show" href={`/en/performances/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ATHINAION</span>}</div><h3>{p.title}</h3></a>):<p class="empty">Upcoming performances will be announced soon.</p>}</div></section><section class="section shell"><div class="sectionHead"><div><small>02 / OUR STAGES</small><h2>OUR STAGES.</h2></div><a class="lineLink" href="/en/stages">DISCOVER MORE ↗</a></div><div class="stages"><a href="/en/stages" class="stage"><img src={photo} alt="Main Stage"/><div><h3>MAIN STAGE</h3></div></a><a href="/en/stages" class="stage"><img src={upstage} alt="Upstage"/><div><img class="upstageLogo" src={upstageLogo} alt="Upstage"/></div></a></div></section></main></Site>