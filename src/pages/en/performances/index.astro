---
import Site from '../../../layouts/Site.astro';import {shows} from '../../../lib/pocketbase.js';const productions=await shows('en');
---
<Site lang="en" title="Performances"><main class="shell innerPage"><small>01 / ON STAGE</small><h1>PERFORMANCES.</h1><div class="stageFilters" role="group" aria-label="Filter by stage"><button type="button" class="stageFilter active" data-stage="all" aria-pressed="true">ALL</button><button type="button" class="stageFilter" data-stage="central" aria-pressed="false">MAIN STAGE</button><button type="button" class="stageFilter" data-stage="upstage" aria-pressed="false">UPSTAGE</button></div><div class="stageFilters statusFilters" role="group" aria-label="Filter by status"><button type="button" class="statusFilter active" data-status="all" aria-pressed="true">ALL</button><button type="button" class="statusFilter" data-status="now" aria-pressed="false">NOW PLAYING</button><button type="button" class="statusFilter" data-status="past" aria-pressed="false">FINISHED</button><button type="button" class="statusFilter" data-status="upcoming" aria-pressed="false">COMING SOON</button></div><div class="shows">{productions.length?productions.map(p=><a class="show" data-stages={p.stageTypes.join(" ")} data-status={p.displayStatus} href={`/en/performances/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ATHINAION</span>}</div><h3>{p.title}</h3><small class="statusText">{({now:"Now playing",past:"Finished",upcoming:"Coming soon"}[p.displayStatus]||"")}</small><div class="showStageTags">{p.stageTypes.map(stage=><span>{stage==="central"?"MAIN STAGE":"UPSTAGE"}</span>)}</div></a>):<p class="empty">Upcoming performances will be announced soon.</p>}</div></main><script is:inline>
(()=>{const buttons=[...document.querySelectorAll('.stageFilter')];const cards=[...document.querySelectorAll('.show[data-stages]')];const statusButtons=[...document.querySelectorAll('.statusFilter')];let activeStage='all',activeStatus='all';const apply=()=>cards.forEach(card=>card.hidden=(activeStage!=='all'&&!card.dataset.stages.split(' ').includes(activeStage))||(activeStatus!=='all'&&card.dataset.status!==activeStatus));buttons.forEach(button=>button.addEventListener('click',()=>{const value=button.dataset.stage;buttons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});activeStage=value;apply()}));statusButtons.forEach(button=>button.addEventListener('click',()=>{activeStatus=button.dataset.status;statusButtons.forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});apply()}))})();
</script></Site>