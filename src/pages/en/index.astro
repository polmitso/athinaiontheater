---
import Site from '../../layouts/Site.astro';
import {shows,formatDate} from '../../lib/pocketbase.js';
import {heroPhoto,photo,upstage,upstageLogo} from '../../lib/assets.js';
const productions=await shows('en');
---
<Site lang="en" title="Athinaion Theatre"><main><section class="hero"><img class="heroPhoto" src={heroPhoto} alt="Athinaion Theatre"/><div class="shell heroText"><h1>A theatre where we meet</h1><p>At Athinaion we stage performances for young and old, host fellow artists, and open our stage to whatever deserves to be told in front of an audience. We look forward to seeing you.</p><div class="heroActions"><a class="btnPrimary" href="/en/performances">WHAT’S ON</a><a class="btnGhost" href="/en/stages">OUR STAGES</a></div></div></section><section class="section shell"><div class="sectionHead"><div><h2>What’s on</h2></div><a class="lineLink" href="/en/performances">All performances →</a></div><div class="shows">{productions.length?productions.filter(p=>p.displayStatus!=="past").slice(0,3).map(p=><a class="show" href={`/en/performances/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ATHINAION</span>}</div><span class="showStage">{p.stageTypes.map(s=>s==="central"?"MAIN STAGE":"UPSTAGE").join(" · ")}</span><h3>{p.title}</h3>{p.presentations[0]?.start&&<span class="showWhen">From {formatDate(p.presentations[0].start)}</span>}</a>):<p class="empty">We are preparing our next performances and will share them here as soon as they are ready.</p>}</div></section><section class="section shell"><div class="sectionHead"><div><h2>Our stages</h2></div><a class="lineLink" href="/en/stages">More →</a></div><div class="stages"><a href="/en/stages" class="stage"><img src={photo} alt="Main Stage"/><div><h3>Main Stage</h3><p>340 seats, for performances that need room to breathe.</p></div></a><a href="/en/stages" class="stage"><img src={upstage} alt="Upstage"/><div><img class="upstageLogo" src={upstageLogo} alt="Upstage"/><p>145 seats, closer to the audience.</p></div></a></div></section><section class="hireBand"><div class="shell hireBandInner"><div><h2>Looking for a home for your work?</h2><p>The Main Stage and Upstage are open to companies, artists and organisations. Tell us about your idea and we will explore together how it could live on our stage.</p></div><a class="btnGhost brass" href="/en/venue-hire">TALK TO US</a></div></section></main></Site>