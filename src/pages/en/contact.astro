---
import Site from '../../layouts/Site.astro';import {assets} from '../../lib/assets.js';const {centralPlan,upstagePlan}=await assets();
---
<Site lang="en" title="Contact"><main class="shell innerPage"><h1>Contact</h1><div class="contactPage"><div><h2>Athinaion Theatre</h2><p><a href="https://maps.app.goo.gl/BKQLTFDM2Xx6h2L27" target="_blank" rel="noopener noreferrer">35 Vasilissis Olgas Avenue<br/>Thessaloniki 546 41 ↗</a></p><p><a href="tel:+306985603020">+30 6985 603020</a></p><p><a href="mailto:athinaiontheater@gmail.com">athinaiontheater@gmail.com</a></p><a class="lineLink" href="https://maps.app.goo.gl/BKQLTFDM2Xx6h2L27" target="_blank" rel="noopener noreferrer">GOOGLE MAPS ↗</a></div><div class="mapPanel"><iframe title="Athinaion Theatre map" src="https://www.google.com/maps?q=Leoforos+Vasilissis+Olgas+35,+Thessaloniki&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div><section class="hireInfo" id="venue-hire"><h2>Venue hire information</h2><p class="pageLead">The Main Stage and Upstage are open to companies, artists and organisations looking for a home for their work. Tell us about your idea and we will explore together how it could live on our stage.</p><div class="floorPlans"><figure><img src={centralPlan} alt="Main Stage floor plan"/><figcaption>MAIN STAGE · FLOOR PLAN</figcaption></figure><figure><img src={upstagePlan} alt="Upstage floor plan"/><figcaption>UPSTAGE · FLOOR PLAN</figcaption></figure></div><a class="lineLink" href="mailto:athinaiontheater@gmail.com?subject=Venue%20hire%20-%20Athinaion%20Theatre">TALK TO US →</a></section></main></Site>