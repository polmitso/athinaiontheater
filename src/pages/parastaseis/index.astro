---
import Site from '../../layouts/Site.astro';import {shows} from '../../lib/pocketbase.js';const productions=await shows();
---
<Site title="Παραστάσεις"><main class="shell innerPage"><small>01 / ON STAGE</small><h1>ΠΑΡΑΣΤΑΣΕΙΣ.</h1><div class="shows">{productions.length?productions.map(p=><a class="show" href={`/parastaseis/${p.slug}`}><div class="poster">{p.poster?<img src={p.poster} alt={p.title}/>:<span>ΑΘΗΝΑΙΟΝ</span>}</div><h3>{p.title}</h3></a>):<p class="empty">Οι επόμενες παραστάσεις θα ανακοινωθούν σύντομα.</p>}</div></main></Site>